# Copy this file to .env and set your own secrets before running docker compose.
#   cp .env.example .env
# .env is gitignored. Never commit real secrets.

# MySQL passwords (used by the db service and by gophish's connection string).
MYSQL_PASSWORD=change-me-gophish
MYSQL_ROOT_PASSWORD=change-me-root

# Password for the initial "admin" account, created on first run.
GOPHISH_INITIAL_ADMIN_PASSWORD=change-me-admin

# Reverse-proxy overlay only: the browser-facing hostname Caddy serves.
# Defaults to "localhost". Set to your domain for automatic HTTPS.
#CADDY_SITE_ADDRESS=gophish.example.com
